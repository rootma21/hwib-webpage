---
import Button from '~/components/ui/Button.astro';
---

<div
  class="relative m-auto max-w-4xl text-center intersect-once intercept-no-queue motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
>
  <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tighter tracking-tighter mb-4 font-heading">
    Upcoming Events
  </h1>
  <p class="text-lg sm:text-xl text-gray-700 dark:text-gray-300 mb-6">
    See what's next and register in a couple of clicks.
  </p>

  <div class="rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700 shadow-lg mb-6">
    <iframe
      src="https://luma.com/embed/calendar/cal-wG6qhc5JGh2jlXA/events"
      class="w-full h-[400px]"
      style="border: none;"
      allowfullscreen
      aria-label="HWIB events calendar"
      loading="lazy"></iframe>
  </div>

  <div class="flex flex-wrap gap-4 justify-center">
    <Button variant="primary" href="/events" text="See Upcoming Events" icon="tabler:calendar" />
  </div>
</div>

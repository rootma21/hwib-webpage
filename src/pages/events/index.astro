---
import { SITE } from '~/config/site/config.js';
import { LUMA_URL } from '~/config/social';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: SITE.title,
  description: SITE.description,
  dontUseTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero>
    <Fragment slot="title"> Events </Fragment>

    <Fragment slot="subtitle">
      Browse and register for upcoming events below, or
      <a href={LUMA_URL} target="_blank" rel="noopener" class="text-primary dark:text-blue-300 font-semibold underline"
        >view the full calendar on Luma</a
      >.
    </Fragment>

    <Fragment slot="content">
      <div
        class="w-full max-w-4xl mx-auto rounded-lg overflow-hidden border border-gray-200 dark:border-slate-700 shadow-lg"
      >
        <iframe
          src="https://luma.com/embed/calendar/cal-wG6qhc5JGh2jlXA/events"
          class="w-full h-[450px] sm:h-[600px]"
          style="border: none;"
          allowfullscreen
          aria-label="HWIB events calendar"
          loading="lazy"></iframe>
      </div>
    </Fragment>
  </Hero>
</Layout>

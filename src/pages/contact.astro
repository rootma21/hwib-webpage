---
import Layout from '~/layouts/PageLayout.astro';
import { SITE } from '~/config/site/config.js';
import { CONTACT_EMAIL } from '~/config/social';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: SITE.title,
  description: SITE.description,
  dontUseTitleTemplate: true,
};

const GOOGLE_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSdwQUZAchxcgsM5qUOkagfmQ7usFebBoAMeA-gheSiRExibhA/viewform?usp=preview';
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText title="Let's Connect!" />

  <Features2
    title="Get in Touch"
    columns={2}
    items={[
      {
        title: 'Email',
        description: CONTACT_EMAIL,
        icon: 'tabler:mail',
        callToAction: { href: `mailto:${CONTACT_EMAIL}` },
      },
      {
        title: 'Contact Form',
        description: 'Reach out to us using our form',
        icon: 'tabler:forms',
        callToAction: { target: '_blank', href: GOOGLE_FORM_URL },
      },
    ]}
  />
</Layout>
